# Copia este archivo como .env y cambia los valores.
NODE_ENV=development
PORT=3000

# Conexion a PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vertice
DB_SSL=false

# En produccion con Neon usa SSL y la cadena con sslmode=require:
# DATABASE_URL=postgresql://usuario:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/vertice?sslmode=require
# DB_SSL=true

# Clave secreta para firmar los JWT (minimo 16 caracteres)
JWT_SECRET=cambia_esta_clave_por_una_larga_y_aleatoria
JWT_EXPIRES_IN=2h

# Origenes permitidos por CORS separados por coma, o * para todos
CORS_ORIGIN=http://localhost:3000

# Usuario administrador que crea el script de seed
ADMIN_NAME=Admin Vertice
ADMIN_EMAIL=admin@vertice.local
ADMIN_PASSWORD=Vertice123!
